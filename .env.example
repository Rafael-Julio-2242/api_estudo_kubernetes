# App
APP_ENV=local
APP_VERSION=
GIT_SHA=

# Server
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_PATH=./data/notes.db

# Shutdown
SHUTDOWN_DELAY_SECONDS=0

# Auth
AUTH_MODE=local
JWT_ISSUER=notes-api
JWT_AUDIENCE=notes-api
JWT_ALG=HS256
JWT_TTL_SECONDS=3600

# Required when AUTH_MODE=local and JWT_ALG=HS256 (min 32 chars):
JWT_SECRET=change-me-in-production-must-be-32-chars-min

# Required when AUTH_MODE=local and JWT_ALG=RS256:
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...
# Or point to files (takes priority):
# JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key

# OIDC mode:
# OIDC_JWKS_URL=https://idp.example.com/realms/notes/protocol/openid-connect/certs

# Optional seed admin (only when AUTH_MODE=local):
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=changeme
