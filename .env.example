# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=local
# APP_VERSION=1.0.0        # defaults to package.json version
# GIT_SHA=abc1234          # defaults to "unknown"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info             # trace | debug | info | warn | error | fatal

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/notes.db

# ── Shutdown ─────────────────────────────────────────────────────────────────
SHUTDOWN_DELAY_SECONDS=0   # seconds to wait after SIGTERM before closing (k8s: 5–15)

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_MODE=local            # local | oidc

JWT_ISSUER=notes-api
JWT_AUDIENCE=notes-api
JWT_TTL_SECONDS=3600

# ── Local mode / HS256 (default) ─────────────────────────────────────────────
JWT_ALG=HS256
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars!!
# JWT_SECRET_FILE=/run/secrets/jwt_secret   # alternative: read from file

# ── Local mode / RS256 (uncomment to switch) ─────────────────────────────────
# JWT_ALG=RS256
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key

# ── OIDC mode (AUTH_MODE=oidc) ────────────────────────────────────────────────
# AUTH_MODE=oidc
# OIDC_JWKS_URL=http://keycloak:8080/realms/notes/protocol/openid-connect/certs
# JWT_ISSUER=http://keycloak:8080/realms/notes
# JWT_AUDIENCE=notes-api

# ── Seed admin (local mode only) ─────────────────────────────────────────────
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me
# SEED_ADMIN_PASSWORD_FILE=/run/secrets/admin_password
